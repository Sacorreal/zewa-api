# Copiar a .env.local, .env.develop o .env.production según el ambiente.
# NODE_ENV no va aquí: lo fija cada script de package.json.

PORT=3001

# Orígenes del frontend autorizados por CORS, separados por coma, sin "*".
# Opcional en local (por defecto http://localhost:3000); requerido en develop/production.
# CORS_ORIGINS=https://zewa.co,https://www.zewa.co

# ── local (.env.local): conexión por host, sin SSL ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=zewa

# ── develop / production (.env.develop, .env.production): URL con SSL ──
# DATABASE_URL=postgresql://usuario:clave@host:5432/zewa
# El certificado del servidor se verifica por defecto. Opcionales:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_REJECT_UNAUTHORIZED=false   # solo si el proveedor no ofrece CA (inseguro)

# ── Almacenamiento: DigitalOcean Spaces (todos los ambientes; un Space por ambiente) ──
# Claves en: DigitalOcean → API → Spaces Keys. El bucket debe ser privado (sin "File Listing" público).
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=zewa-local
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Opcionales:
# SPACES_CDN_URL=https://zewa-local.nyc3.cdn.digitaloceanspaces.com   # base de URLs públicas
# SPACES_SIGNED_URL_TTL_SECONDS=900                                    # vigencia de URLs privadas

# ── Notificaciones por correo (todos los ambientes) ──
# Proveedor: resend (por defecto) | log (solo local: escribe el correo en consola, no envía)
# EMAIL_PROVIDER=resend
# Remitente con dominio verificado en el proveedor.
EMAIL_FROM="ZEWA <no-reply@zewa.co>"
# EMAIL_REPLY_TO=soporte@zewa.co
# URL base del frontend para los enlaces de los correos (p. ej. activación de cuenta).
# Cambiarla por la URL de pruebas para que los enlaces apunten a ese ambiente.
ENDPOINT_APP_WEB=http://localhost:3000
# Requerida si EMAIL_PROVIDER=resend. Clave en: Resend → API Keys.
RESEND_API_KEY=
