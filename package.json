    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
