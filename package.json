  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=local nest start --watch",
    "start:debug": "cross-env NODE_ENV=local nest start --debug --watch",
    "start:develop": "cross-env NODE_ENV=develop node dist/main",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "migration:generate": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:generate -d src/shared/config/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:run -d src/shared/config/database/data-source.ts",
    "migration:revert": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:revert -d src/shared/config/database/data-source.ts",
    "migration:show": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:show -d src/shared/config/database/data-source.ts",
    "migration:run:develop": "cross-env NODE_ENV=develop typeorm-ts-node-commonjs migration:run -d src/shared/config/database/data-source.ts",
    "migration:run:prod": "cross-env NODE_ENV=production typeorm-ts-node-commonjs migration:run -d src/shared/config/database/data-source.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
